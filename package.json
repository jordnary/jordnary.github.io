{
  "name": "jordnary.github.io",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run sync:github && npm run sync:feeds",
    "prebuild": "npm run sync:github && npm run sync:feeds",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "sync:feeds": "node scripts/sync-rss.mjs",
    "sync:github": "node scripts/sync-github.mjs",
    "sync:projects": "node --use-env-proxy scripts/sync-project-docs.mjs",
    "test:homepage": "node tests/homepage-touch.browser.mjs && node tests/homepage-transition.browser.mjs",
    "test:homepage-performance": "node tests/homepage-performance.browser.mjs",
    "test:projects": "node tests/projects.browser.mjs",
    "test:learning": "node tests/learning.browser.mjs",
    "test:learning-toolkit": "node tests/learning-toolkit.browser.mjs",
    "test:learning-ink": "node tests/learning-ink.browser.mjs",
    "test:learning-geometry": "node tests/learning-geometry.browser.mjs",
    "test:learning-pointer": "node tests/learning-pointer.browser.mjs",
    "test:site-mouse": "node tests/site-mouse.browser.mjs",
    "test:navbar": "node --test tests/nav-scroll-visibility.test.ts && node tests/navbar.browser.mjs",
    "test:gallery": "node tests/image-gallery.browser.mjs",
    "test:project-details": "node tests/project-details.browser.mjs",
    "test:project-docs": "node --test tests/project-docs.test.mjs tests/routes.test.ts",
    "test:project-visuals": "node --test tests/project-visuals.test.mjs",
    "posters:render": "node scripts/render-project-posters.mjs",
    "test:snapshots": "node --test tests/github-snapshot.test.mjs tests/cleanup-history.test.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "github-slugger": "^2.0.0",
    "motion": "^12.40.0",
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "6.5.10",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.3.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "image-size": "^2.0.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  },
  "overrides": {
    "pixi-live2d-display": {
      "gh-pages": "^6.3.0"
    }
  }
}
